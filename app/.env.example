# Copiar este archivo como ".env" (mismo directorio) y completar con la IP
# real. .env NO se sube a git (ver .gitignore) -- cada persona tiene el suyo,
# igual que backend/.env y firmware/datos_simulados/config.h.

# IP de la PC donde corre el backend (no "localhost": el celular necesita
# la IP real de la red para encontrar tu compu, igual que MQTT_BROKER en
# firmware/datos_simulados/config.h.example).
EXPO_PUBLIC_API_URL=http://192.168.1.3:3000
